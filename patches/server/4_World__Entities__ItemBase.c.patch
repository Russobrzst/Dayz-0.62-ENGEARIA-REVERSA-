+    void DZ62_WriteRotationSnapshot(ParamsWriteContext ctx)
+    {
+        int count = 0;
+        if (m_DZ62Types) count = m_DZ62Types.Count();
+        autoptr Param3<int, int, int> header = new Param3<int, int, int>(620063, m_DZ62Revision, count);
+        ctx.Write(header);
+        for (int i = 0; i < count; i++)
+        {
+            autoptr Param5<string, int, int, int, int> row = new Param5<string, int, int, int, int>(m_DZ62Types.Get(i), m_DZ62X.Get(i), m_DZ62Y.Get(i), m_DZ62W.Get(i), m_DZ62H.Get(i));
+            ctx.Write(row);
+        }
+    }
