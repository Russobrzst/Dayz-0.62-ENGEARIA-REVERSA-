+    void DZ62_ApplyRotationSnapshot()
+    {
+        if (GetGame().IsServer()) return;
+        m_DZ62RetryCount++;
+        Cargo cargo = GetCargo();
+        bool complete = cargo != NULL;
+        bool trace = m_DZ62RetryCount == 1 || (m_DZ62RetryCount % 40) == 0;
+        int ping = -999;
+        if (cargo) ping = cargo.Grid2Index(0, -620062);
+        if (cargo && ping == 620063)
+        {
+            for (int i = 0; i < m_DZ62Types.Count(); i++)
+            {
+                int index = -1;
+                for (int j = 0; j < cargo.GetItemCount(); j++)
+                {
+                    int x, y;
+                    cargo.GetItemPos(j, x, y);
+                    if (x == m_DZ62X.Get(i) && y == m_DZ62Y.Get(i) && cargo.GetItem(j).GetType() == m_DZ62Types.Get(i)) index = j;
+                }
+                if (index == -1)
+                {
+                    if (trace) Print("[DZ62_PENDING] missing item type=" + m_DZ62Types.Get(i) + " cargo_count=" + cargo.GetItemCount());
+                    complete = false; continue;
+                }
+                int width = m_DZ62W.Get(i), height = m_DZ62H.Get(i);
+                int result = cargo.Grid2Index(1610612736 | (height << 20) | (width << 12) | index, -620062);
+                if (result != 0 && result != 1)
+                {
+                    if (trace) Print("[DZ62_PENDING] native status=" + result + " revision=" + m_DZ62ReceivedRevision);
+                    complete = false; continue;
+                }
+                int observed_w, observed_h;
+                cargo.GetItemSize(index, observed_w, observed_h);
+                if (observed_w != width || observed_h != height)
+                {
+                    if (trace) Print("[DZ62_PENDING] getter mismatch w=" + observed_w + " h=" + observed_h);
+                    complete = false; continue;
+                }
+                Print("[DZ62_CLIENT] verified revision=" + m_DZ62ReceivedRevision + " type=" + m_DZ62Types.Get(i) + " w=" + observed_w + " h=" + observed_h + " status=" + result);
+            }
+        }
+        else
+        {
+            if (trace) Print("[DZ62_PENDING] cargo binding ping=" + ping);
+            complete = false;
+        }
+        if (complete)
+        {
+            Print("[DZ62_CLIENT] applied revision=" + m_DZ62ReceivedRevision + " entries=" + m_DZ62Types.Count());
+            m_DZ62RetryTimer.Stop();
+            autoptr Param1<int> ack = new Param1<int>(m_DZ62ReceivedRevision);
+            GetGame().RPCSingleParam(this, 620064, ack);
+            UIScriptedMenu menu = GetGame().GetUIManager().FindMenu(MENU_INVENTORY);
+            if (menu) GetGame().GetCallQueue(CALL_CATEGORY_GUI).Call(menu, "PerformRefreshInventory", NULL);
+            PlayerBase viewer = (PlayerBase)GetGame().GetPlayer();
+            if (viewer)
+            {
+
+
+            }
+        }
+        else if (m_DZ62RetryCount >= 480)
+        {
+            Print("[DZ62_ERROR] pending snapshot failed revision=" + m_DZ62ReceivedRevision);
+            m_DZ62RetryTimer.Stop();
+        }
+    }
