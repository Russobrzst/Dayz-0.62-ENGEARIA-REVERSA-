+    void DZ62_ReadRotationSnapshot(ParamsReadContext ctx)
+    {
+        autoptr Param3<int, int, int> header = new Param3<int, int, int>(0, 0, 0);
+        if (!ctx.Read(header)) { Print("[DZ62_ERROR] snapshot header read failed"); return; }
+        if (header.param1 != 620063 || header.param3 < 0 || header.param3 > 16)
+        { Print("[DZ62_ERROR] incompatible snapshot protocol"); return; }
+        // Read the entire frame before deciding whether to accept its revision.
+        autoptr array<string> types = new array<string>;
+        autoptr array<int> xs = new array<int>;
+        autoptr array<int> ys = new array<int>;
+        autoptr array<int> widths = new array<int>;
+        autoptr array<int> heights = new array<int>;
+        for (int i = 0; i < header.param3; i++)
+        {
+            autoptr Param5<string, int, int, int, int> row = new Param5<string, int, int, int, int>("", 0, 0, 0, 0);
+            if (!ctx.Read(row)) { Print("[DZ62_ERROR] snapshot row read failed"); return; }
+            if (row.param2 < 0 || row.param3 < 0 || row.param4 < 1 || row.param5 < 1 || row.param4 > 255 || row.param5 > 255)
+            { Print("[DZ62_ERROR] invalid snapshot dimensions"); return; }
+            types.Insert(row.param1); xs.Insert(row.param2); ys.Insert(row.param3);
+            widths.Insert(row.param4); heights.Insert(row.param5);
+        }
+        if (GetGame().IsServer() || header.param2 < m_DZ62ReceivedRevision || header.param3 == 0) return;
+        DZ62_InitRotationLists();
+        m_DZ62Types.Clear(); m_DZ62X.Clear(); m_DZ62Y.Clear(); m_DZ62W.Clear(); m_DZ62H.Clear();
+        for (int k = 0; k < types.Count(); k++)
+        {
+            m_DZ62Types.Insert(types.Get(k)); m_DZ62X.Insert(xs.Get(k)); m_DZ62Y.Insert(ys.Get(k));
+            m_DZ62W.Insert(widths.Get(k)); m_DZ62H.Insert(heights.Get(k));
+        }
+        m_DZ62ReceivedRevision = header.param2;
+        m_DZ62RetryCount = 0;
+        if (!m_DZ62RetryTimer) m_DZ62RetryTimer = new Timer(CALL_CATEGORY_GAMEPLAY);
+        m_DZ62RetryTimer.Stop();
+        m_DZ62RetryTimer.Run(0.25, this, "DZ62_ApplyRotationSnapshot", NULL, true);
+        DZ62_ApplyRotationSnapshot();
+    }
