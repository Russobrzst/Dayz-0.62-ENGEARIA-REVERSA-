+    void DZ62_InitRotationLists()
+    {
+        if (m_DZ62Types) return;
+        m_DZ62Types = new array<string>;
+        m_DZ62X = new array<int>;
+        m_DZ62Y = new array<int>;
+        m_DZ62W = new array<int>;
