+    int DZ62_SetRotationExisting(int index, bool rotated)
+    {
+        if (!GetGame().IsServer()) return -201;
+        Cargo cargo = GetCargo();
+        if (!cargo || index < 0 || index >= cargo.GetItemCount() || index > 4095) return -202;
+        if (cargo.Grid2Index(0, -620062) != 620063) return -203;
+        EntityAI child = cargo.GetItem(index);
+        int width, height;
+        GetGame().GetInventoryItemSize(child, width, height);
+        if (rotated) { int swap = width; width = height; height = swap; }
+        if (width < 1 || height < 1 || width > 255 || height > 255) return -204;
+        int x, y;
+        cargo.GetItemPos(index, x, y);
+        DZ62_InitRotationLists();
+        string item_type = child.GetType();
+        int slot = -1;
+        for (int i = 0; i < m_DZ62Types.Count(); i++)
+        {
+            if (m_DZ62Types.Get(i) == item_type && m_DZ62X.Get(i) == x && m_DZ62Y.Get(i) == y) slot = i;
+        }
+        if (slot == -1 && m_DZ62Types.Count() >= 16) return -205;
+        int result = cargo.Grid2Index(268435456 | (height << 20) | (width << 12) | index, -620062);
+        if (result != 0 && result != 1) return result;
+        if (slot == -1)
+        {
+            // This debug trial supports one stable container entry; enforce a small bound.
+            m_DZ62Types.Insert(item_type); m_DZ62X.Insert(x); m_DZ62Y.Insert(y);
+            m_DZ62W.Insert(width); m_DZ62H.Insert(height);
+        }
+        else { m_DZ62W.Set(slot, width); m_DZ62H.Set(slot, height); }
+        m_DZ62Revision++;
+        SetSynchDirty(); // Dirty the container whose script payload owns this snapshot.
+        Print("[DZ62_SERVER] revision=" + m_DZ62Revision + " type=" + item_type + " x=" + x + " y=" + y + " w=" + width + " h=" + height);
+        return result;
+    }
