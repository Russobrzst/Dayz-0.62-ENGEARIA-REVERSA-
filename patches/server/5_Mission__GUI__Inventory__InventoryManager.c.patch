+    void DZ62_ToggleSpace()
+    {
+        if (!IsDragging() || !GetItem()) return;
+        if (m_DZPendingRequest > 0) { DZ62_SpaceMessage("Aguarde a confirmacao do servidor."); return; }
+        if (!m_DZOriginReady || !m_DZOriginOwner || !m_DZOriginOwner.Ptr() || (!m_DZOriginEquipped && !DZ62_AccessibleCargo(m_DZOriginOwner.Ptr())))
+        { DZ62_SpaceMessage("Arraste um item do equipamento, maos, proximidade ou cargo acessivel."); return; }
+        if (m_DZBaseW == m_DZBaseH || m_DZBaseW < 1 || m_DZBaseH < 1 || m_DZBaseW > 255 || m_DZBaseH > 255)
+        { DZ62_SpaceMessage("Este teste de giro usa itens retangulares."); return; }
+        m_DZSpaceUsed = true;
+        m_DZDesiredRotated = !m_DZDesiredRotated;
+        vector wanted = DZ62_CurrentFootprint(GetItem());
+        int wanted_w = Math.Round(wanted[1]), wanted_h = Math.Round(wanted[2]);
+        SetItemSize((wanted_w * GetNormalItemSize()) + (GRID_CARGO_GAP * (wanted_w - 1)), (wanted_h * GetNormalItemSize()) + (GRID_CARGO_GAP * (wanted_h - 1)));
+        if (m_grid && m_grid.HasItem(GetItem()))
+        {
+            vector data = m_grid.GetItems().Get(GetItem());
+            Widget background = m_grid.GetItemBackground(Math.Round(data[0]));
+            if (background)
+            {
+                ItemPreviewWidget preview = background.FindAnyWidget("Preview");
+                if (preview) preview.SetModelOrientation(DZ62_PreviewRotation(GetItem()));
+            }
+        }
+        if (DZ62_CanFitOriginal(wanted_w, wanted_h)) SetItemColor(InventoryGrid.ITEM_COLOR_GOOD);
+        else SetItemColor(InventoryGrid.ITEM_COLOR_WRONG);
+        Print("[DZ62_SPACE_PREVIEW] type=" + GetItem().GetType() + " w=" + wanted_w + " h=" + wanted_h);
+    }
