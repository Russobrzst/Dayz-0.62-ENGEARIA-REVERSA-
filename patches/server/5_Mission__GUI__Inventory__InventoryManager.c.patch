+            {
+                Cargo hint_cargo=m_DZOriginOwner.Ptr().GetCargo();
+                int hint_index=hint_cargo.FindEntityInCargo(GetItem());
+                if(hint_index>=0) hint_status=hint_cargo.Grid2Index(1342177280 | (height<<20) | (width<<12) | hint_index,-620062);
+            }
+            if(hint_status!=0) {SetItemColor(InventoryGrid.ITEM_COLOR_WRONG);DZ62_SpaceMessage("Nao foi possivel preparar a orientacao para sincronizar.");return false;}
+            if (m_DZRequestCounter < GetGame().GetTime()) m_DZRequestCounter = GetGame().GetTime();
+            m_DZRequestCounter++;
+            m_DZPendingRequest = m_DZRequestCounter;
+            autoptr Param6<EntityAI,EntityAI,vector,vector,int,bool> request = new Param6<EntityAI,EntityAI,vector,vector,int,bool>(GetItem(),m_DZOriginOwner.Ptr(),Vector(m_DZOriginX,m_DZOriginY,m_DZOriginW+256*m_DZOriginH),Vector(col,row,0),m_DZPendingRequest,m_DZDesiredRotated);
+            GetGame().RPCSingleParam(target,620068,request);
+            Print("[DZ62_MOVE_REQUEST] id=" + m_DZPendingRequest + " type=" + GetItem().GetType() + " x=" + col + " y=" + row + " w=" + width + " h=" + height);
+        }
+        return true;
+    }
