+    void DZ62_SpaceReply(int request, int status, int width, int height)
+    {
+        if (request != m_DZPendingRequest) return;
+        m_DZPendingRequest = 0;
+        Print("[DZ62_SPACE_REPLY] id=" + request + " status=" + status + " w=" + width + " h=" + height);
+        if (status == 0 || status == 1) DZ62_SpaceMessage("Servidor confirmou posicao e giro: " + width + "x" + height + ".");
+        else if(status==-241) DZ62_SpaceMessage("Destino invalido: o recipiente nao pode conter a si mesmo.");
+        else if(status==-239) DZ62_SpaceMessage("Servidor aceitou; sincronizacao local ainda pendente. Reabra o inventario.");
+        else DZ62_SpaceMessage("O servidor recusou o giro. O item continua na origem.");
+    }
