+    bool DZ62_AccessibleCargo(EntityAI target)
+    {
+        Man viewer = GetGame().GetPlayer();
+        if (!viewer || !target || !target.GetCargo()) return false;
+        Man owner = target.GetOwnerPlayer();
+        if (owner) return owner == viewer;
+        return vector.Distance(viewer.GetPosition(),target.GetPosition()) <= 3;
+    }
+    bool DZ62_CargoCycle(EntityAI target,EntityAI item)
+    {
+        if(!target || !item) return true;
+        EntityAI ancestor=target;
+        for(int depth=0;depth<128;depth++)
+        {
+            if(ancestor==item) return true;
+            if(!ancestor) return false;
+            ancestor=ancestor.GetOwner();
+        }
+        return true;
+    }
+
+    bool DZ62_FitDestination(EntityAI target, EntityAI item, int x, int y, int width, int height)
+    {
+        if(DZ62_CargoCycle(target,item)) return false;
+        Cargo cargo = target.GetCargo();
+        if (!cargo || x < 0 || y < 0 || width < 1 || height < 1 || x+width > cargo.GetWidth() || y+height > cargo.GetHeight()) return false;
+        for (int i=0;i<cargo.GetItemCount();i++)
+        {
+            if (cargo.GetItem(i)==item) continue;
+            int rx,ry,rw,rh;
+            cargo.GetItemPos(i,rx,ry); cargo.GetItemSize(i,rw,rh);
+            if (x<rx+rw && x+width>rx && y<ry+rh && y+height>ry) return false;
+        }
+        return true;
+    }
