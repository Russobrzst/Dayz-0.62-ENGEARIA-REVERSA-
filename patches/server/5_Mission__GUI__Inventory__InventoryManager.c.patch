+    bool DZ62_CanFitOriginal(int width, int height)
+    {
+        if (!m_DZOriginOwner || !m_DZOriginOwner.Ptr()) return false;
+        Cargo cargo = m_DZOriginOwner.Ptr().GetCargo();
+        if (!cargo || m_DZOriginX + width > cargo.GetWidth() || m_DZOriginY + height > cargo.GetHeight()) return false;
+        int own_index = cargo.FindEntityInCargo(GetItem());
+        if (own_index < 0) return false;
+        for (int i = 0; i < cargo.GetItemCount(); i++)
+        {
+            if (i == own_index) continue;
+            int x, y, w, h;
+            cargo.GetItemPos(i, x, y); cargo.GetItemSize(i, w, h);
+            if (m_DZOriginX < x+w && m_DZOriginX+width > x && m_DZOriginY < y+h && m_DZOriginY+height > y) return false;
+        }
+        return true;
+    }
