+    bool DZ62_IsStoredRotation(InventoryItem item)
+    {
+        if (!item) return false;
+        EntityAI owner = item.GetOwner();
+        if (!owner || !owner.GetCargo()) return false;
+        Cargo cargo = owner.GetCargo();
+        int index = cargo.FindEntityInCargo(item);
+        if (index < 0) return false;
+        int base_w, base_h, actual_w, actual_h;
+        GetGame().GetInventoryItemSize(item, base_w, base_h);
+        cargo.GetItemSize(index, actual_w, actual_h);
+        return base_w != base_h && actual_w == base_h && actual_h == base_w;
+    }
+
+    bool DZ62_RestrictDrop()
+    {
+        return IsDragging() && (m_DZSpaceUsed || DZ62_IsStoredRotation(GetItem()));
+    }
