+    // Read the placed record before falling back to the class dimensions.
+    vector DZ62_CurrentFootprint(InventoryItem item)
+    {
+        if (m_DZSpaceUsed && IsDragging() && item == GetItem())
+        {
+            if (m_DZDesiredRotated) return Vector(0, m_DZBaseH, m_DZBaseW);
+            return Vector(0, m_DZBaseW, m_DZBaseH);
+        }
+        int width = 1, height = 1;
+        if (!item) return Vector(0, width, height);
+        GetGame().GetInventoryItemSize(item, width, height);
+        EntityAI owner = item.GetOwner();
+        if (owner)
+        {
+            Cargo cargo = owner.GetCargo();
+            if (cargo)
+            {
+                int index = cargo.FindEntityInCargo(item);
+                if (index >= 0) cargo.GetItemSize(index, width, height);
+            }
+        }
+        return Vector(0, width, height);
+    }
+
+    vector DZ62_PreviewRotation(InventoryItem item)
+    {
+        if (m_DZSpaceUsed && IsDragging() && item == GetItem())
+        {
+            if (m_DZDesiredRotated) return Vector(0,0,90);
+            return Vector(0,0,0);
+        }
+        if (DZ62_IsStoredRotation(item)) return Vector(0,0,90);
+        return Vector(0,0,0);
+    }
