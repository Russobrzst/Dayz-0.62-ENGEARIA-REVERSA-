+        vector wanted = DZ62_CurrentFootprint(GetItem());
+        int width = Math.Round(wanted[1]), height = Math.Round(wanted[2]);
+        if (!DZ62_FitDestination(target,GetItem(),col,row,width,height))
+        { SetItemColor(InventoryGrid.ITEM_COLOR_WRONG); return false; }
+        SetItemColor(InventoryGrid.ITEM_COLOR_GOOD);
