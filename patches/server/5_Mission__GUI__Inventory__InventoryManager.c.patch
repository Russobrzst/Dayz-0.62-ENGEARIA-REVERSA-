+    bool DZ62_ExternalSourceValid(EntityAI item,EntityAI source,int kind)
+    {
+        Man actor=GetGame().GetPlayer();if(!item || !source || !actor) return false;
+        if(kind==-1) return source==actor && item.GetOwner()==actor && actor.HasAttachment(item);
+        if(kind==-4) return source==actor && actor.GetEntityInHands()==item;
+        if(kind==-2) return source==item && !item.GetOwner() && vector.Distance(actor.GetPosition(),item.GetPosition())<=3;
+        return false;
+    }
