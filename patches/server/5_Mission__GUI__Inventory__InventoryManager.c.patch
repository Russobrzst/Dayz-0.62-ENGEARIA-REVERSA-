+    bool m_DZHandsPending;
+    bool DZ62_ReequipDrop(EntityAI actor,bool testOnly,bool toHands=false,InventoryItem selected=NULL)
+    {
+        InventoryItem item=selected;if(!item) item=GetItem();
+        if((!selected && !IsDragging()) || !item || !actor || actor!=GetGame().GetPlayer() || m_DZPendingRequest>0 || !item.CanRemoveEntity()) return false;
+        EntityAI owner=item.GetOwner();
+        int slot=item.GetSlotId();
+        bool placement_allowed=false;
+        if(toHands && actor.IsInherited(Man))
+        {
+            Man holder=(Man)actor;slot=-1;
+            placement_allowed=!holder.GetEntityInHands() && holder.CanAddEntityInHands(item);
+        }
+        else placement_allowed=slot>=0 && slot<=65535 && actor.CanAddAttachmentEx(item,slot);
+        if(!owner || !owner.GetCargo() || !DZ62_AccessibleCargo(owner) || !placement_allowed) {SetItemColor(InventoryGrid.ITEM_COLOR_WRONG);return false;}
+        Cargo cargo=owner.GetCargo();int index=cargo.FindEntityInCargo(item);
+        if(index<0) return false;
+        SetItemColor(InventoryGrid.ITEM_COLOR_GOOD);
+        if(testOnly) return true;
+        int x,y,w,h,base_w,base_h;cargo.GetItemPos(index,x,y);cargo.GetItemSize(index,w,h);GetGame().GetInventoryItemSize(item,base_w,base_h);
+        if(cargo.Grid2Index(1342177280 | (base_h<<20) | (base_w<<12) | index,-620062)!=0) return false;
+        if(toHands)
+        {
+            int armed=cargo.Grid2Index(536870912 | (h<<20) | (w<<12) | index,-620062);
+            int begin_operation=9;begin_operation=begin_operation<<28;
+            if(armed!=0 || !actor.CanAddEntityInCargoEx(item,-620062,begin_operation)) return false;
+        }
+        if(m_DZRequestCounter<GetGame().GetTime()) m_DZRequestCounter=GetGame().GetTime();
+        m_DZRequestCounter++;m_DZPendingRequest=m_DZRequestCounter;m_DZHandsPending=toHands;
+        GetGame().RPCSingleParam(owner,620071,new Param5<EntityAI,EntityAI,vector,int,int>(item,actor,Vector(x,y,w+256*h),slot,m_DZPendingRequest));
+        Print("[DZ62_REEQUIP_REQUEST] id="+m_DZPendingRequest+" type="+item.GetType()+" slot="+slot);
+        return true;
+    }
+    void DZ62_ReequipReply(int request,int status)
+    {
+        if(request!=m_DZPendingRequest) return;
+        m_DZPendingRequest=0;
+        Print("[DZ62_REEQUIP_REPLY] id="+request+" status="+status);
+        if(status==0 || status==1)
+        {
+            if(m_DZHandsPending) DZ62_SpaceMessage("Servidor confirmou o item nas maos.");
+            else DZ62_SpaceMessage("Servidor confirmou o equipamento.");
+        }
+        else if(m_DZHandsPending && (status==-255 || status==-254)) DZ62_SpaceMessage("A transferencia para as maos ainda nao foi confirmada. Confira o inventario.");
+        else if(m_DZHandsPending) DZ62_SpaceMessage("Nao foi possivel levar o item as maos; confira se estao livres.");
+        else DZ62_SpaceMessage("O servidor recusou o equipamento; confira o slot de destino.");
+        m_DZHandsPending=false;
