+    bool DZ62_SpaceInput(int key, bool pressed)
+    {
+        if (key != KeyCode.KC_SPACE) return false;
+        if (!pressed) { m_DZSpaceHeld = false; return DZ62_SpaceActive(); }
+        if (!DZ62_SpaceActive()) return false;
+        GetGame().GetInput().DisableKey(KeyCode.KC_SPACE);
+        if (!m_DZSpaceHeld)
+        {
+            Print("[DZ62_SPACE_INPUT] mission/widget press key=" + key);
+            m_drag_manager.DZ62_ToggleSpace();
+        }
+        m_DZSpaceHeld = true;
+        return true;
+    }
+    bool OnKeyDown(Widget w, int x, int y, int key)
+    {
+        if (DZ62_SpaceInput(key,true)) return true;
+        return super.OnKeyDown(w,x,y,key);
+    }
+    bool OnKeyUp(Widget w, int x, int y, int key)
+    {
+        if (DZ62_SpaceInput(key,false)) return true;
+        return super.OnKeyUp(w,x,y,key);
+    }
+    bool OnKeyPress(Widget w, int x, int y, int key)
